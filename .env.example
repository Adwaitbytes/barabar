# Razorpay TEST-mode credentials (never use live keys here)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Anthropic key for the Tier-D investigator and Ask-the-books (optional; evals use cached outputs without it)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: point the Anthropic SDK at a gateway (OpenRouter speaks the Messages format) and pick models per task
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# BARABAR_MODEL=anthropic/claude-sonnet-5        # investigator + ask-the-books (quality-critical)
# BARABAR_MODEL_CHEAP=openai/gpt-4o-mini         # narration extraction fallback (grammar re-validates)
# Storage: sqlite file for local demo; postgres URL in production
DATABASE_URL=sqlite:///./data/local/barabar.db
# Web -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
